# All variables are optional. The app works without any keys (public RPC + mock history).

# Custom RPC endpoints (fallback: public RPCs from viem chain definitions)
NEXT_PUBLIC_RPC_SEPOLIA=
NEXT_PUBLIC_RPC_POLYGON_AMOY=
NEXT_PUBLIC_RPC_BASE_SEPOLIA=

# Transaction history provider: etherscan | alchemy | mock
NEXT_PUBLIC_HISTORY_PROVIDER=mock
# Etherscan API v2 (one free key for all supported chains)
NEXT_PUBLIC_ETHERSCAN_API_KEY=
# Alchemy (free tier)
NEXT_PUBLIC_ALCHEMY_API_KEY=

# PBKDF2 iterations (min 310000, default 600000)
NEXT_PUBLIC_KDF_ITERATIONS=600000
